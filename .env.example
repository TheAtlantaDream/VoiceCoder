# Copy to .env and fill in. Docker Compose and scripts/run-local.sh read this file.
# Never commit .env.

ANTHROPIC_API_KEY=
BRIDGE_END_WORD=over
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=

# Optional — empty uses Haiku (claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional port overrides (host:container). Defaults are set by run-local.sh.
# FRONTEND_PUBLISH=8080:80
# BRIDGE_PUBLISH=127.0.0.1:8000:8000
# WHISPER_PUBLISH=127.0.0.1:18080:8080
# VSCODE_PUBLISH=127.0.0.1:3000:3000
